  "icon": "assets/reterra/icon.png",
  "authors": ["ReTerra contributors"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {"main": ["dev.reterra.ReTerra"],"client":["dev.reterra.client.ReTerraClient"]},
  "mixins": ["reterra.mixins.json"],
  "depends": {"fabricloader": ">=${loader_version}", "minecraft": "${minecraft_compatibility}", "java": ">=${java_version}", "fabric-api": "*"}
}
